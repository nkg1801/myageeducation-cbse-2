<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#FFFFFF" >
   
     <GridView
        android:id="@+id/gridViewRewardsTable"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="10dp"
        android:numColumns="4" >
    </GridView>
    
    <!-- just draw a  line -->
    <View
        android:layout_height="2dip"
        android:layout_width="wrap_content"
        android:layout_below="@+id/gridViewRewardsTable"
        android:layout_marginTop="10dp"
        android:background="#55460d" />
    
    <TextView
        android:id="@+id/textViewRewardName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/gridViewRewardsTable"
        android:layout_marginTop="30dp"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="50dp"
        android:text="Reward name:"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <EditText
        android:id="@+id/editTextRewardName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/gridViewRewardsTable"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="200dp"
        android:layout_alignBaseline="@+id/textViewRewardName"
        android:ems="10"
        android:hint="Reward name" >
        <requestFocus />
    </EditText>
    
     <TextView
        android:id="@+id/textViewForPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewRewardName"
        android:layout_alignLeft="@+id/textViewRewardName"
        android:layout_marginTop="30dp"
        android:text="For Points"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
    <EditText
        android:id="@+id/editText1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/editTextRewardName"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/textViewRewardName"
        android:layout_alignBaseline="@+id/textViewForPoints"
        android:ems="10"
        android:inputType="number"
        android:hint="Enter the points" />
    
    <TextView
        android:id="@+id/textViewReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/textViewForPoints"
        android:layout_below="@+id/textViewForPoints"
        android:layout_marginTop="36dp"
        android:text="Reward"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <EditText
        android:id="@+id/editText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/editTextRewardName"
        android:layout_below="@+id/editText1"
        android:layout_alignBaseline="@+id/textViewReward"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="Enter the Reward" />

    <Button
        android:id="@+id/buttonAddReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/editText2"
        android:layout_marginTop="100dp"
        android:text="Add Reward" />
</RelativeLayout>
