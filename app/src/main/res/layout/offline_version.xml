<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

    <TextView
        android:id="@+id/textViewTitle"
        android:text="The Offline version of the app offers the following advantages:"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:textColor="#B833FF"
        android:textSize="20sp"
        android:layout_marginTop="@dimen/offline_version_firstview_topmargin"
        android:layout_marginLeft="20dp"
       android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        />

<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:id="@+id/tableLayout1"
             android:layout_width="fill_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="20dp"
    android:layout_below="@+id/textViewTitle">

    <TableRow
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <TextView
            android:id="@+id/imageViewOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="1. "
            android:textSize="@dimen/offline_version_textsize"
            android:textColor="#aeeaee"
            android:layout_column="1"/>

        <TextView
            android:id="@+id/textViewAdvantage1"
            android:text="No advertisements. Less clutter, more fun"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_toRightOf="@+id/imageViewOne"
            android:layout_below="@+id/textViewTitle"
            android:textColor="#aeeaee"
            android:textSize="@dimen/offline_version_textsize"
            android:layout_column="2" />
    </TableRow>

    <TableRow
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <TextView
            android:id="@+id/imageViewTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="2. "
            android:textSize="@dimen/offline_version_textsize"
            android:textColor="#aeeaee"
            android:layout_column="1"/>

        <TextView
            android:id="@+id/textViewAdvantage2"
            android:text="Works without any internet connection."
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:textColor="#aeeaee"
            android:textSize="@dimen/offline_version_textsize"
            android:layout_column="2" />
    </TableRow>

    <TableRow
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

        <TextView
            android:id="@+id/imageViewThree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="3. "
            android:textSize="@dimen/offline_version_textsize"
            android:textColor="#aeeaee"
            android:layout_column="1"/>

        <TextView
            android:id="@+id/textViewAdvantage3"
            android:text="Much faster than the online version."
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:textColor="#aeeaee"
            android:textSize="@dimen/offline_version_textsize"
            android:layout_column="2" />
    </TableRow>
</TableLayout>

    <TextView
        android:id="@+id/textViewNote"
        android:text="Note: A one time download of the Question Database (size: less than 10 MB) will be done during the very first test. Thereafter, no internet connection will be required for the subsequent tests."
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/tableLayout1"
        android:textColor="#FF3361"
        android:layout_centerHorizontal="true"
        android:textSize="15sp"
        android:gravity="center_horizontal"
        />

    <TextView
        android:id="@+id/textViewGetItNow"
        android:text="Check it out at the play store by clicking the image below."
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/textViewNote"
        android:textColor="#E6FF33"
        android:layout_centerHorizontal="true"
        android:textSize="20sp"
        android:gravity="center_horizontal"
        />

    <ImageView
        android:id="@+id/imageViewSubjectImage"
        android:layout_width="250dp"
        android:layout_height="76dp"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@+id/textViewGetItNow"
        android:onClick="onClickPlayStoreImage"
        android:src="@drawable/playstore"/>
    </RelativeLayout>